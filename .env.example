# --- Supabase ---
# Find these in your Supabase project: Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Service role key is SECRET. Server-only. Used by the product seed script
# and any admin-only server routes. Never expose this with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- PhonePe Payment Gateway (server-only, never NEXT_PUBLIC_) ---
# From the PhonePe Business Dashboard for your merchant account.
PHONEPE_CLIENT_ID=your-phonepe-client-id
PHONEPE_CLIENT_SECRET=your-phonepe-client-secret
PHONEPE_CLIENT_VERSION=1
# "sandbox" while testing in PhonePe's UAT environment, "production" once you go live
PHONEPE_ENV=sandbox

# Username/password YOU choose and configure in the PhonePe dashboard for
# webhook (callback) authentication. PhonePe signs callbacks using these.
PHONEPE_WEBHOOK_USERNAME=choose-a-username
PHONEPE_WEBHOOK_PASSWORD=choose-a-strong-password

# Public base URL of this deployed site (used to build PhonePe redirect URLs).
# e.g. http://localhost:3000 in dev, https://lattutop.com in production.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
